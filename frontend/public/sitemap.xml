<?xml version="1.0" encoding="UTF-8"?>
<!--
  Replace https://www.baghaus.com below with your production domain before
  deploying. Product and category pages are dynamic (see /products and
  /categories in the app) and are not enumerated here - point search engines
  at them via the internal links on the Products/Categories pages, or extend
  the backend with a dynamic /sitemap.xml route if you need every product URL
  listed individually.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.baghaus.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.baghaus.com/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://www.baghaus.com/products</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://www.baghaus.com/categories</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://www.baghaus.com/contact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
